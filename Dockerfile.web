# Web app: build the static bundle, serve it with nginx, proxy /api to the compile server.
FROM node:24-slim AS build
WORKDIR /app
COPY package.json yarn.lock tsconfig.base.json ./
COPY packages/engine/package.json ./packages/engine/
COPY packages/web/package.json ./packages/web/
COPY packages/server/package.json ./packages/server/
RUN corepack enable && yarn install --frozen-lockfile
COPY demo_sketches ./demo_sketches
COPY packages/engine ./packages/engine
COPY packages/web ./packages/web
# .git is not in the build context: pass the version in (see README).
ARG APP_VERSION
RUN yarn workspace @avr8js-ws2812/web build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/packages/web/dist /usr/share/nginx/html
EXPOSE 80
