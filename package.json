{
  "name": "avr8js-ws2812-emulator",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "start": "yarn workspace @avr8js-ws2812/web start",
    "server": "yarn workspace @avr8js-ws2812/server start",
    "typecheck": "yarn workspaces run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "golden:update": "node scripts/update-golden.ts",
    "check": "yarn typecheck && yarn lint && yarn format:check && yarn test"
  },
  "volta": {
    "node": "24.22.2",
    "yarn": "1.22.19"
  },
  "type": "module"
}
